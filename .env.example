# Copy this file to .env and list every IP address or DNS name used to open
# HomelabHQ. Keep .env local to the deployment; it is ignored by Git.
# Example: HLHQ_TLS_HOSTS=192.168.1.10,homelabhq.lan
HLHQ_TLS_HOSTS=

# Optional server overrides. Compose already supplies the recommended bind
# address; leave these commented unless the deployment requires a change.
# HLHQ_HOST=0.0.0.0
# HLHQ_READINESS_TIMEOUT=2
# HLHQ_POLL_INTERVAL=60
# HLHQ_PROXMOX_POLL_INTERVAL=120
# HLHQ_TRUENAS_POLL_INTERVAL=300
# HLHQ_DOCKER_POLL_INTERVAL=300
# HLHQ_POLL_TIMEOUT=10
# HLHQ_PROXMOX_TIMEOUT=20
# HLHQ_TRUENAS_TIMEOUT=20
# HLHQ_DOCKER_TIMEOUT=120
# HLHQ_NETWORK_STALE_AFTER=180
# HLHQ_PROXMOX_STALE_AFTER=360
# HLHQ_TRUENAS_STALE_AFTER=600
# HLHQ_DOCKER_STALE_AFTER=600
